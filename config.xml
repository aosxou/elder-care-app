<?xml version="1.0" encoding="UTF-8"?>
<config>
  <!--
    TODO: 서버 설정
    - 포트 번호 설정
    - 호스트 주소 설정
    - 데이터베이스 연결 설정
  -->
  <server>
    <port>3000</port>
    <host>localhost</host>
    <environment>development</environment>
  </server>

  <!--
    TODO: 데이터베이스 설정
    - SQLite 데이터베이스 경로 설정
    - 연결 풀 설정
    - 백업 설정
  -->
  <database>
    <type>sqlite</type>
    <path>./data/eldercare.db</path>
    <backupPath>./data/backups</backupPath>
  </database>

  <!--
    TODO: 사용자 권한 설정
    - 관리자 권한
    - 간병인 권한
    - 보호자 권한
    - 노인 사용자 권한
  -->
  <permissions>
    <admin>true</admin>
    <caregiver>true</caregiver>
    <guardian>true</guardian>
    <elderly>true</elderly>
  </permissions>

  <!--
    TODO: 알림 설정
    - 건강 지표 경고 임계값
    - 약물 복용 시간 알림
    - 비상 연락처 알림
  -->
  <notifications>
    <healthAlerts>true</healthAlerts>
    <medicineReminders>true</medicineReminders>
    <emergencyAlerts>true</emergencyAlerts>
  </notifications>

  <!--
    TODO: API 설정
    - 의료 데이터 API 연동
    - 날씨 API 연동
    - 응급차 호출 API
  -->
  <externalAPIs>
    <healthAPI>enabled</healthAPI>
    <weatherAPI>enabled</weatherAPI>
    <emergencyAPI>enabled</emergencyAPI>
  </externalAPIs>
</config>
